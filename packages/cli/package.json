  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "nypm": "^0.6.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@bigcommerce/eslint-config": "^2.13.1",
    "@bigcommerce/eslint-config-catalyst": "workspace:^",
    "@commander-js/extra-typings": "^15.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^8.57.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
