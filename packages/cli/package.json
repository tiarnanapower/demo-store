{
  "name": "@bigcommerce/catalyst",
  "version": "0.1.0",
  "type": "module",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "templates"
  ],
  "private": true,
  "scripts": {
    "dev": "tsup --watch",
    "dev:run": "node dist/index.js",
    "typecheck": "tsc --noEmit",
